# Maintainer: Tessa contributors <maintainers@tessa.invalid>
# Source tarball is produced by packaging/iso/build.sh from the working tree.
pkgname=tessa-iso
pkgver=0.2.5
pkgrel=1
pkgdesc="Tessa tiled Wayland desktop for the Tessa Linux ISO"
arch=('x86_64')
url="https://github.com/Keychrom/Tessa"
license=('MIT')
depends=('wlroots0.20' 'scenefx' 'wayland' 'libinput' 'libxkbcommon' 'pixman' 'cairo' 'pango' 'glib2' 'xcursor-themes')
makedepends=('zig' 'pkgconf')
provides=('tessa')
conflicts=('tessa')
source=('tessa.tar.gz')
sha256sums=('SKIP')

build() {
    cd "$srcdir/tessa"
    ./scripts/build.sh -Doptimize=ReleaseSafe -Dscenefx=true --prefix "$srcdir/out"
}

package() {
    cd "$srcdir/tessa"
    install -Dm755 "$srcdir/out/bin/tessa" "$pkgdir/usr/bin/tessa"
    install -Dm755 "$srcdir/out/bin/tessa-panel" "$pkgdir/usr/bin/tessa-panel"
    install -Dm755 "$srcdir/out/bin/tessa-ctl" "$pkgdir/usr/bin/tessa-ctl"
    install -Dm755 scripts/tessa-session "$pkgdir/usr/bin/tessa-session"
    install -Dm644 session/tessa.desktop \
        "$pkgdir/usr/share/wayland-sessions/tessa.desktop"
    install -Dm644 config/config.example "$pkgdir/usr/share/tessa/config.example"
    install -Dm644 examples/themes/vermilion-ink/theme.conf \
        "$pkgdir/usr/share/tessa/themes/vermilion-ink/theme.conf"
    install -Dm644 packaging/portal/tessa.portal \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/tessa.portal"
    install -Dm644 README.md "$pkgdir/usr/share/doc/tessa/README.md"
    install -Dm644 README.ja.md "$pkgdir/usr/share/doc/tessa/README.ja.md"
    install -Dm644 docs/ARCHITECTURE.md "$pkgdir/usr/share/doc/tessa/ARCHITECTURE.md"
    install -Dm644 docs/ARCHITECTURE.ja.md "$pkgdir/usr/share/doc/tessa/ARCHITECTURE.ja.md"
    install -Dm644 docs/CUSTOMIZATION.md "$pkgdir/usr/share/doc/tessa/CUSTOMIZATION.md"
    install -Dm644 docs/CUSTOMIZATION.ja.md "$pkgdir/usr/share/doc/tessa/CUSTOMIZATION.ja.md"
    install -Dm644 docs/EXTENDING.md "$pkgdir/usr/share/doc/tessa/EXTENDING.md"
    install -Dm644 docs/EXTENDING.ja.md "$pkgdir/usr/share/doc/tessa/EXTENDING.ja.md"
    install -Dm644 docs/GUIDE.md "$pkgdir/usr/share/doc/tessa/GUIDE.md"
    install -Dm644 docs/GUIDE.ja.md "$pkgdir/usr/share/doc/tessa/GUIDE.ja.md"
    install -Dm644 docs/ROADMAP.md "$pkgdir/usr/share/doc/tessa/ROADMAP.md"
    install -Dm644 docs/ROADMAP.ja.md "$pkgdir/usr/share/doc/tessa/ROADMAP.ja.md"
    install -Dm644 debian/man/tessa.1 "$pkgdir/usr/share/man/man1/tessa.1"
    install -Dm644 debian/man/tessa-panel.1 "$pkgdir/usr/share/man/man1/tessa-panel.1"
    install -Dm644 debian/man/tessa-ctl.1 "$pkgdir/usr/share/man/man1/tessa-ctl.1"
    install -Dm644 debian/man/tessa-session.1 "$pkgdir/usr/share/man/man1/tessa-session.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
