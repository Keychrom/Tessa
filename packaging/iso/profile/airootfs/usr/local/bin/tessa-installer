#!/bin/sh
# Launch Calamares from the live Tessa session. The live user has passwordless
# sudo; running as root is needed for partitioning and chroot work.
set -eu

if [ "$(id -u)" -eq 0 ]; then
    exec calamares "$@"
fi

runtime=${XDG_RUNTIME_DIR:-"/run/user/$(id -u)"}
exec sudo -E env \
    XDG_RUNTIME_DIR="$runtime" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
    DISPLAY="${DISPLAY:-}" \
    PYTHONPATH=/usr/lib/calamares \
    QT_QPA_PLATFORM="${TESSA_CALAMARES_QT_PLATFORM:-wayland}" \
    calamares "$@"
