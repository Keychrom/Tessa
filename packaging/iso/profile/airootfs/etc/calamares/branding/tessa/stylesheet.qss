QWidget {
    color: #eef2f8;
    background-color: #0a0f1a;
}

QPushButton {
    background-color: #e2684f;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
}

QPushButton:disabled {
    background-color: #3a4050;
    color: #9aa6bc;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #141b2a;
    border: 1px solid #293347;
    border-radius: 5px;
    padding: 5px;
}

QProgressBar {
    border: 1px solid #293347;
    border-radius: 5px;
    background-color: #141b2a;
}

QProgressBar::chunk {
    background-color: #e2684f;
    border-radius: 4px;
}
