# Tessa configuration
# Install this file as ~/.config/tessa/config.
# Values are simple `key = value` lines. Lines starting with # are ignored.
# Relative include paths are resolved next to the including file.
# include = keybindings.conf

terminal = kitty
gaps = 10
outer_gaps = 16
border_width = 2
master_ratio = 0.58

# master: classic master/stack
# mosaic: spiral tessera layout
# grid: balanced grid
# columns: equal-width columns
# Super+T cycles all four at runtime, per output and workspace.
layout = master
# Optional per-workspace initial layout overrides:
# layout_1 = grid
# layout_2 = columns

# Start tessa-panel together with the compositor.
panel = true

# Start xwayland-satellite for X11 applications and export DISPLAY.
# "auto" picks the first free display (:0, :1, ...).
xwayland = true
xwayland_display = auto

# Where wlr-randr changes are persisted. The default is
# $XDG_CONFIG_HOME/tessa/outputs.conf (or ~/.config/tessa/outputs.conf).
# TESSA_OUTPUT_CONFIG overrides this. Use an absolute path.
# output_config = /home/you/.config/tessa/outputs.conf

# XKB keyboard layout. Empty values use the environment defaults.
# Example: kb_layout = us,de
#          kb_options = grp:alt_shift_toggle
kb_layout =
kb_variant =
kb_options =
kb_model =
kb_rules =
repeat_rate = 25
repeat_delay = 600

# The shell palette. Both the compositor borders and the panel use these.
accent = #e2684f
bg = #0a0f1a
font = Inter

# Run commands at startup, or react to compositor events.
# Hooks receive TESSA_EVENT plus TESSA_WINDOW_ID, TESSA_WORKSPACE,
# TESSA_OUTPUT, TESSA_APP_ID, TESSA_TITLE, and related variables.
# startup = fcitx5 -d
# hook = window-open notify-send "Window opened" "$TESSA_TITLE"
# hook = workspace-change ~/.config/tessa/workspace.sh

# Extra launcher entries (panel-side; included files also work).
# launcher_entry = Notes | foot -e nvim ~/notes.md
# launcher_entry = Lock screen | swaylock

# Additional or overriding key bindings.
# XKB keysym names are used: Return, Tab, Left, Right, 1, h, ...
# bind = SUPER+Return terminal
# bind = SUPER+d launcher
# bind = SUPER+t toggle-layout
# bind = SUPER+g set-layout grid
# bind = SUPER+1 workspace 1
# bind = SUPER+SHIFT+1 move-to-workspace 1
# bind = SUPER+h focus left
# bind = SUPER+SHIFT+h move left
# bind = SUPER+ctrl+h ratio -0.03
# bind = SUPER+shift+e quit
