# Tessa configuration
# Install this file as ~/.config/tessa/config.
# Values are simple `key = value` lines. Lines starting with # are ignored.
# Relative include paths are resolved next to the including file.
# include = keybindings.conf

terminal = kitty
gaps = 10
outer_gaps = 16
border_width = 2
master_ratio = 0.58

# master: classic master/stack
# mosaic: spiral tessera layout
# grid: balanced grid
# columns: equal-width columns
# custom: external layout helper (see below)
# Super+T cycles the four built-in layouts at runtime, per output and workspace.
# Runtime choices are saved to outputs.conf and restored on restart.
layout = master
# Optional per-workspace initial layout overrides. These seed workspaces with no
# saved runtime choice; a config reload updates non-overridden workspaces.
# layout_1 = grid
# layout_2 = columns

# Layout tuning. master_count stacks that many windows in the master column.
# mosaic falls back to grid when a tile would be smaller than mosaic_min_size.
# grid_columns = 0 chooses ceil(sqrt(window_count)).
# master_count = 2
# mosaic_ratio = 0.62
# mosaic_min_size = 160
# grid_columns = 0

# Declarative window rules. Match app-id, title, and/or output; values support
# shell-style * and ? patterns. Actions are separated by semicolons.
# window-rule = app-id=pavucontrol; float=true
# window-rule = title=Picture-in-Picture; float=true; position=40,40
# window-rule = app-id=firefox; workspace=2
# window-rule = title=GIMP*; float=false

# Per-workspace layout/spacing overrides. Runtime layout choices still win over
# the layout seed; Super+Ctrl+H/L adjusts the active workspace master ratio.
# workspace-rule = ws=2; layout=grid; gaps=4; outer-gaps=8; master-ratio=0.65

# External custom tiling. The helper is a long-lived process; it receives
# tab-separated LAYOUT/AREA/WINDOW/END requests and returns RECT/END responses.
# See docs/CUSTOMIZATION.md and examples/layout-cascade.py.
# layout = custom
# layout_helper = python3 ~/.config/tessa/layout.py
# layout_helper_timeout = 100

# Start tessa-panel together with the compositor.
panel = true
# Panel geometry and bar palette. Changes apply on config reload by recreating
# the bar layer surface.
bar_height = 44
bar_top_margin = 12
bar_side_margin = 16
panel_bg = #0e1320
panel_fg = #eef2f8

# Commands for the power menu (right-click the TESSA mark).
power_lock = loginctl lock-session
power_suspend = systemctl suspend
power_reboot = systemctl reboot
power_off = systemctl poweroff

# Screenshot PNG output (default ~/Pictures/Screenshots). Super+Shift+S opens
# the region/full-output capture UI.
screenshot_dir = ~/Pictures/Screenshots

# Volume control. Empty commands auto-detect wpctl, pactl, then amixer.
# Super+Shift+A opens the volume popover. Override individual commands here;
# custom commands run through /bin/sh and the status command should print a
# percentage such as "42%".
# volume_status = wpctl get-volume @DEFAULT_AUDIO_SINK@
# volume_up = wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
# volume_down = wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
# volume_mute = wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Start xwayland-satellite for X11 applications and export DISPLAY.
# "auto" picks the first free display (:0, :1, ...).
xwayland = true
xwayland_display = auto

# Where wlr-randr changes are persisted. The default is
# $XDG_CONFIG_HOME/tessa/outputs.conf (or ~/.config/tessa/outputs.conf).
# TESSA_OUTPUT_CONFIG overrides this. Use an absolute path.
# output_config = /home/you/.config/tessa/outputs.conf

# XKB keyboard layout. Empty values use the environment defaults.
# Example: kb_layout = us,de
#          kb_options = grp:alt_shift_toggle
kb_layout =
kb_variant =
kb_options =
kb_model =
kb_rules =
repeat_rate = 25
repeat_delay = 600

# The shell palette. Both the compositor borders and the panel use these.
accent = #e2684f
bg = #0a0f1a
# Empty border_active uses accent.
# border_active = #e2684f
# border_inactive = #293347
font = Inter

# Run commands at startup, or react to compositor events.
# Hooks receive TESSA_EVENT plus TESSA_WINDOW_ID, TESSA_WORKSPACE,
# TESSA_OUTPUT, TESSA_APP_ID, TESSA_TITLE, and related variables.
# startup = fcitx5 -d
# hook = window-open notify-send "Window opened" "$TESSA_TITLE"
# hook = workspace-change ~/.config/tessa/workspace.sh

# Extra launcher entries (panel-side; included files also work).
# launcher_entry = Notes | foot -e nvim ~/notes.md
# launcher_entry = Lock screen | swaylock

# Additional or overriding key bindings.
# XKB keysym names are used: Return, Tab, Left, Right, 1, h, ...
# bind = SUPER+Return terminal
# bind = SUPER+d launcher
# bind = SUPER+v clipboard
# bind = SUPER+SHIFT+s screenshot
# bind = SUPER+m media
# bind = SUPER+SHIFT+t tray
# bind = SUPER+SHIFT+a audio
# bind = SUPER+t toggle-layout
# bind = SUPER+g set-layout grid
# bind = SUPER+1 workspace 1
# bind = SUPER+SHIFT+1 move-to-workspace 1
# bind = SUPER+h focus left
# bind = SUPER+SHIFT+h move left
# bind = SUPER+ctrl+h ratio -0.03
# bind = SUPER+shift+e quit

# Named input modes. In a mode, bindings match without Super. Add
# `mode = default` before returning to the global keymap.
# mode = resize
# bind = h resize-width -30
# bind = l resize-width 30
# bind = Escape enter-mode default
# mode = default
# bind = SUPER+SHIFT+r enter-mode resize
